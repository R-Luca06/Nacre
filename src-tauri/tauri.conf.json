{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nacre",
  "version": "0.1.0",
  "identifier": "app.nacre.terminal",
  "build": {
    "beforeDevCommand": "npm run build:cli && npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web && node scripts/sidecar.mjs release",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "/Library/Desktop Pictures/**", "/System/Library/Desktop Pictures/**"]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/nacre"],
    "category": "DeveloperTool",
    "copyright": "Nacre contributors",
    "shortDescription": "Terminal built around Claude Code",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "opener": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3MEU2ODI2NEQxOTFCMjgKUldRb0d4bE5KbWdPdHg0NzJXRVhYa0NRNTdJd2paYm5xV3NKcWlkaytNU2svSFArejVKdTFXdzEK",
      "endpoints": ["https://github.com/R-Luca06/Nacre/releases/latest/download/latest.json"]
    }
  }
}
